# --- Vapi ---
VAPI_PRIVATE_KEY=your_vapi_private_key
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
VAPI_WEBHOOK_SECRET=change_me_to_a_long_random_string
# This must be your public cloudflared tunnel URL + /webhooks/vapi
VAPI_WEBHOOK_URL=https://your-tunnel-subdomain.trycloudflare.com/webhooks/vapi

# --- Deepgram ---
DEEPGRAM_API_KEY=your_deepgram_api_key
# IMPORTANT: just the voice name, no "aura-" prefix or "-en" suffix
DEEPGRAM_VOICE=asteria

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key

# --- Twilio ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=

# --- Public base URL (used for TwiML / static meme-audio URLs) ---
# Same host as VAPI_WEBHOOK_URL, no trailing slash, no path.
PUBLIC_BASE_URL=https://your-tunnel-subdomain.trycloudflare.com

# --- App ---
APP_ENV=development
APP_PORT=8000
